# ==============================================================================
# Biến Môi Trường Mẫu Cho Dự Án PBL6
# Sao chép tệp này thành .env hoặc điền thông tin vào application-local.properties
# Backend (Spring Boot) KHÔNG tự đọc file .env: đặt các biến backend thành biến môi trường của hệ điều hành / máy chủ,
# hoặc ghi khoá tương ứng vào backend-core/src/main/resources/application-local.properties (gitignore) khi chạy ở máy dev.
# Không commit giá trị thật của mật khẩu / khoá bí mật.
# ==============================================================================

# 1. Cơ sở dữ liệu Supabase / PostgreSQL
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_USERNAME=postgres.rmxemrewhlafbutblqsr
DB_PASSWORD=your_supabase_db_password_here

# 2. JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_minimum_512_bits_length

# 3. AI Service (Python FastAPI) — các biến dưới đây đặt trong ai-service/.env (service đọc .env ở thư mục ai-service);
#    AI_SERVICE_URL / AI_SERVICE_KEY còn được backend đọc (biến môi trường hoặc application-local.properties).
GEMINI_API_KEY=your_gemini_api_key_here
# Model Gemini cho OCR fallback / dịch nghĩa VN (mặc định gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Model dự phòng khi model chính 429/503 (quota riêng theo model); để trống = không dùng
GEMINI_FALLBACK_MODEL=
# Backend gọi ai-service ở đâu; AI_SERVICE_KEY (tuỳ chọn) đặt giống nhau ở cả hai bên để chặn gọi thẳng từ ngoài
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=
# Đường dẫn tesseract.exe trên Windows nếu không nằm trong PATH (OCR ảnh / PDF scan)
TESSERACT_CMD=
# Neo4j / GraphRAG KHÔNG được dùng (quyết định 19/10/2026: mâu thuẫn tài liệu so với từ điển + nguồn tri thức chuẩn, bản đồ
# Hán-Việt dựng từ Unihan / JLPT / JMdict). config.py vẫn đọc ba biến này nhưng không code nào dùng → không cần đặt.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# 4. Gửi email (backend): xác thực email khi đăng ký + quên mật khẩu. Hướng dẫn Gmail: docs/SUPABASE_SETUP.md mục 5.
#    Chưa có SMTP: giữ nguyên các dòng đã comment → không gửi mail thật, link được ghi vào log backend (chỉ dùng khi dev).
#    Có SMTP: bỏ dấu # rồi điền. KHÔNG để SPRING_MAIL_HOST / MAIL_FROM tồn tại mà rỗng: Spring coi biến rỗng là "đã khai báo"
#    → bật gửi mail với host rỗng (gửi lỗi, link cũng không còn ghi ra log) hoặc người gửi rỗng.
#    Xác thực email bật / tắt ở Admin Panel > Cấu hình (khoá email_verification_required, mặc định bật), không phải ở đây.
# SPRING_MAIL_HOST=smtp.gmail.com
# 587 = STARTTLS (Gmail); SMTPS cổng 465 cần thêm khoá mail.smtps.* tương ứng
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# Gmail: App password 16 ký tự (cần bật xác minh 2 bước), không phải mật khẩu đăng nhập Gmail
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Địa chỉ người gửi (giữ dòng này comment = mặc định no-reply@nihongen.local; bỏ # thì PHẢI điền địa chỉ, để rỗng là người gửi
# rỗng); với Gmail nên trùng SPRING_MAIL_USERNAME để không bị chặn
# MAIL_FROM=
# Gốc của link trong email (/verify-email, /reset-password). Mặc định http://localhost:5173; trên máy chủ PHẢI là địa chỉ
# frontend thật, nếu không link trong email trỏ về localhost của người nhận
FRONTEND_URL=http://localhost:5173
# Thời gian chờ SMTP (ms): JavaMail mặc định chờ vô hạn → máy chủ mail treo sẽ kéo treo request đăng ký / quên mật khẩu
MAIL_CONNECT_TIMEOUT_MS=5000
MAIL_TIMEOUT_MS=10000
