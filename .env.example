# ==============================================================================
# Biến Môi Trường Mẫu Cho Dự Án PBL6
# Sao chép tệp này thành .env hoặc điền thông tin vào application-local.properties
# ==============================================================================

# 1. Cơ sở dữ liệu Supabase / PostgreSQL
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_USERNAME=postgres.rmxemrewhlafbutblqsr
DB_PASSWORD=your_supabase_db_password_here

# 2. JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_minimum_512_bits_length

# 3. AI Service (Python FastAPI) — các biến dưới đây đặt trong ai-service/.env (service đọc .env ở thư mục ai-service);
#    AI_SERVICE_URL / AI_SERVICE_KEY còn được backend đọc (biến môi trường hoặc application-local.properties).
GEMINI_API_KEY=your_gemini_api_key_here
# Model Gemini cho OCR fallback / dịch nghĩa VN (mặc định gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Model dự phòng khi model chính 429/503 (quota riêng theo model); để trống = không dùng
GEMINI_FALLBACK_MODEL=
# Backend gọi ai-service ở đâu; AI_SERVICE_KEY (tuỳ chọn) đặt giống nhau ở cả hai bên để chặn gọi thẳng từ ngoài
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=
# Đường dẫn tesseract.exe trên Windows nếu không nằm trong PATH (OCR ảnh / PDF scan)
TESSERACT_CMD=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
